# =========================
# Chat model
# =========================
OPENAI_API_KEY=your_openai_or_dashscope_api_key
OPENAI_MODEL=qwen-plus
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TEXT_MODEL_PROVIDER=glm_sync
GLM_API_KEY=your_bigmodel_token
GLM_MODEL=glm-4-flashx-250414
GLM_ROUTER_MODEL=glm-4-flashx-250414
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_ASYNC_SUBMIT_PATH=/async/chat/completions
GLM_ASYNC_RESULT_PATH=/async-result/{id}
GLM_POLL_INTERVAL_S=1
GLM_MAX_POLL_S=120
GLM_TEMPERATURE=1
AGENT_VERBOSE=false
AGENT_RUNTIME=langgraph
AGENT_STREAMING=true
AGENT_MODE=swarm
AGENT_USE_LANGGRAPH_MEMORY=true
AGENT_TIMEOUT_S=90
AGENT_REQUEST_TIMEOUT_S=60
AGENT_MAX_ITERATIONS=3
ROUTER_MODEL=qwen-max

# =========================
# Multimodal (Qwen-VL)
# =========================
MULTIMODAL_ENABLED=true
MULTIMODAL_PROVIDER=dashscope
MULTIMODAL_API_KEY=your_multimodal_api_key
MULTIMODAL_MODEL=qwen-plus
MULTIMODAL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MULTIMODAL_TIMEOUT_MS=30000
MULTIMODAL_MAX_IMAGE_BYTES=8388608
MULTIMODAL_MAX_IMAGES_PER_REQUEST=3
MULTIMODAL_ALLOWED_MIME=image/jpeg,image/png,image/webp
MULTIMODAL_MIN_IMAGE_BYTES=4096
MULTIMODAL_ASSETS_DIR=data/rag_assets/images
MULTIMODAL_ASSETS_URL_PREFIX=/static/rag_assets/images
MULTIMODAL_UPLOADS_DIR=data/uploads
MULTIMODAL_UPLOADS_URL_PREFIX=/static/uploads
IMAGE_ANALYSIS_ENABLED=true

# =========================
# RAG
# =========================
RAG_ENABLED=true
RAG_SOURCE_DIRS=source_dir/medical_md
RAG_INDEX_DIR=data/medical_rag_index
RAG_TOP_K=4
RAG_RETRIEVAL_K=30
RAG_RRF_K=30
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120
RAG_REBUILD=false

# =========================
# RAG Embedding
# =========================
RAG_EMBEDDING_PROVIDER=dashscope
RAG_EMBEDDING_API_KEY=your_embedding_api_key
RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSIONS=1024
DASHSCOPE_API_KEY=

# =========================
# Query planner
# =========================
RAG_QUERY_PLAN_MODEL=qwen-turbo
RAG_QUERY_PLAN_API_KEY=your_query_plan_api_key
RAG_QUERY_PLAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_QUERY_PLAN_TIMEOUT_MS=2000
RAG_QUERY_PLAN_MAX_VARIANTS=5

# =========================
# Rerank
# =========================
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=qwen3-rerank
RAG_RERANK_API_KEY=your_rerank_api_key
RAG_RERANK_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RAG_RERANK_TOP_N=8
RAG_RERANK_TIMEOUT_MS=8000
RAG_RERANK_CANDIDATE_K=40
RAG_RERANK_BACKEND=qwen
RAG_RERANK_LOCAL_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_DEVICE=cpu
KMP_DUPLICATE_LIB_OK=TRUE

# =========================
# Vector store
# =========================
VECTOR_DB_PROVIDER=faiss
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_documents

# =========================
# Database / checkpointer
# =========================
POSTGRES_URI=postgresql://user:password@localhost:5432/cook

# =========================
# Skills / agents
# =========================
ENABLED_SKILLS=search_knowledge,assess_risk,analyze_symptoms,clinical_guideline,web_search,deep_research,disease_code,analyze_image
SWARM_MAX_WORKERS=2
SWARM_TIMEOUT_S=90
COMPLEXITY_THRESHOLD=0.85
TRIAGE_CONFIDENCE_THRESHOLD=0.75
SUPERVISOR_CONFIDENCE_THRESHOLD=0.6

# =========================
# Guardrails / Harness / HITL
# =========================
GUARDRAILS_ENABLED=true
HARNESS_ENABLED=false
HARNESS_MAX_REPAIR=1
HITL_ENABLED=false
HITL_ACTION=interrupt
HITL_RESUME_DEFAULT=approve

# =========================
# Web search
# =========================
TAVILY_ENABLED=false
TAVILY_API_KEY=your_tavily_api_key

# =========================
# ElevenLabs speech
# =========================
ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=Rachel
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TIMEOUT_MS=30000

# =========================
# Mem0 long-term memory
# =========================
MEM0_ENABLED=false
MEM0_API_KEY=your_mem0_api_key
MEM0_USER_SCOPE=session

# =========================
# Logging
# =========================
LOG_LEVEL=INFO
