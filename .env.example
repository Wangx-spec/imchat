# =========================
# Chat model (existing)
# =========================
OPENAI_API_KEY=your_openai_or_dashscope_chat_api_key
OPENAI_MODEL=qwen-plus
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_VERBOSE=false

# =========================
# RAG - feature switch
# =========================
RAG_ENABLED=true
RAG_SOURCE_DIRS=chapter8,source_dir/HowToCook
RAG_INDEX_DIR=data/rag_index

# Retrieval parameters
RAG_TOP_K=4
RAG_RETRIEVAL_K=12
RAG_RRF_K=60

# Chunking parameters
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# Rebuild switch
RAG_REBUILD=false

# =========================
# RAG Embedding (DashScope)
# =========================
RAG_EMBEDDING_PROVIDER=dashscope
RAG_EMBEDDING_API_KEY=your_dashscope_embedding_api_key
RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSIONS=1024

# Optional fallback key (if you don't set RAG_EMBEDDING_API_KEY)
# DASHSCOPE_API_KEY=your_dashscope_api_key
