# =========================
# Chat model (existing)
# =========================
OPENAI_API_KEY=sk-e71dbc339f874236846714c45a7e822b
OPENAI_MODEL=qwen-plus
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_VERBOSE=false
AGENT_RUNTIME=langgraph
AGENT_STREAMING=true

# =========================
# RAG - feature switch
# =========================
RAG_ENABLED=true
RAG_SOURCE_DIRS=/Users/aimiaomiao/cook-proj/source_dir/file_data
RAG_INDEX_DIR=data/cook_rag_index

# Retrieval parameters
RAG_TOP_K=4
RAG_RETRIEVAL_K=30
RAG_RRF_K=30

# Chunking parameters
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120

# Rebuild switch
RAG_REBUILD=false

# =========================
# RAG Embedding (DashScope)
# =========================
RAG_EMBEDDING_PROVIDER=dashscope
RAG_EMBEDDING_API_KEY=sk-e71dbc339f874236846714c45a7e822b
RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSIONS=1024

# Optional fallback key (if you don't set RAG_EMBEDDING_API_KEY)
# DASHSCOPE_API_KEY=your_dashscope_api_key
# Rerank (Qwen)
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=qwen3-rerank
RAG_RERANK_API_KEY=sk-e71dbc339f874236846714c45a7e822b
RAG_RERANK_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RAG_RERANK_TOP_N=8
RAG_RERANK_TIMEOUT_MS=3000
RAG_RERANK_CANDIDATE_K=40