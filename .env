# =========================
# Chat model (existing)
# =========================
OPENAI_API_KEY=sk-fde0a4026e4d4d0496bad0c1a04c92c9
OPENAI_MODEL=qwen-plus
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_VERBOSE=false
AGENT_RUNTIME=langgraph
AGENT_STREAMING=true
AGENT_MODE=swarm

# =========================
# Multimodal (Qwen-VL)
# =========================
MULTIMODAL_ENABLED=true
MULTIMODAL_API_KEY=sk-fde0a4026e4d4d0496bad0c1a04c92c9
MULTIMODAL_MODEL=qwen3.6-plus
MULTIMODAL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MULTIMODAL_TIMEOUT_MS=30000
MULTIMODAL_MAX_IMAGE_BYTES=8388608
MULTIMODAL_MAX_IMAGES_PER_REQUEST=3


# =========================
# RAG - feature switch
# =========================
# 领域：生物医学（Biomedical Multi-Agent Assistant）
# 语料来源：source_dir/parsed_md/{topic}/*.md（阶段 1 由 scripts/ingest_pdf.py 生成）
# 原始 PDF 放置：source_dir/raw/ 与 source_dir/raw_extras/
RAG_ENABLED=true
RAG_SOURCE_DIRS=source_dir/file_data,source_dir/parsed_md
RAG_INDEX_DIR=data/medical_rag_index
RAG_FORCE_TOOL_ROUTE=true
RAG_FORCE_TOOL_POLISH=true

# query planner parameters
RAG_QUERY_PLAN_MODEL=qwen-turbo
RAG_QUERY_PLAN_API_KEY=sk-fde0a4026e4d4d0496bad0c1a04c92c9
RAG_QUERY_PLAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_QUERY_PLAN_TIMEOUT_MS=2000
RAG_QUERY_PLAN_MAX_VARIANTS=5

# Retrieval parameters
RAG_TOP_K=4
RAG_RETRIEVAL_K=30
RAG_RRF_K=30

# Chunking parameters
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120

# Rebuild switch
RAG_REBUILD=false

# =========================
# RAG Embedding (DashScope)
# =========================
RAG_EMBEDDING_PROVIDER=dashscope
RAG_EMBEDDING_API_KEY=sk-fde0a4026e4d4d0496bad0c1a04c92c9
RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSIONS=1024

# Optional fallback key (if you don't set RAG_EMBEDDING_API_KEY)
# DASHSCOPE_API_KEY=your_dashscope_api_key
# Rerank (Qwen)
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=qwen3-rerank
RAG_RERANK_API_KEY=sk-fde0a4026e4d4d0496bad0c1a04c92c9
RAG_RERANK_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RAG_RERANK_TOP_N=8
RAG_RERANK_TIMEOUT_MS=8000
RAG_RERANK_CANDIDATE_K=40
RAG_RERANK_BACKEND=qwen          # qwen | crossencoder | none
RAG_RERANK_LOCAL_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_DEVICE=cpu
KMP_DUPLICATE_LIB_OK=TRUE


# database
POSTGRES_URI=postgresql://appuser:123123@localhost:5432/cook

# =========================
# Skills configuration
# =========================
ENABLED_SKILLS=medical_kb,conversation,time,calculator

# =========================
# Guardrails configuration
# =========================
GUARDRAILS_ENABLED=true

# =========================
# Supervisor confidence threshold
# =========================
SUPERVISOR_CONFIDENCE_THRESHOLD=0.6

# =========================
# Tavily API key
# =========================
TAVILY_API_KEY=sk-e71dbc339f874236846714c45a7e822b
TAVILY_ENABLED=false


SWARM_MAX_WORKERS=3
SWARM_TIMEOUT_S=90
COMPLEXITY_THRESHOLD=0.6